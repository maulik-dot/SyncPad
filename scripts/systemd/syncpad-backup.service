[Unit]
Description=SyncPad Encrypted Database Backup Service
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/syncpad
ExecStart=/bin/bash /opt/syncpad/scripts/backup_db.sh
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
