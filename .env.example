# ==============================================================================
# SyncPad Production Environment Variables Template
# Copy to '.env' before deploying. Never commit actual secrets to version control.
# ==============================================================================

# Database Configuration
POSTGRES_DB=syncpad_db
POSTGRES_USER=syncpad_user
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_MIN_24_CHARS
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/syncpad_db

# JWT Authentication Secret (MUST BE AT LEAST 256-BIT / 32 CHARACTERS)
# Generate a fresh key using: openssl rand -hex 32
JWT_SECRET=GENERATE_FRESH_SECRET_WITH_OPENSSL_RAND_HEX_32
JWT_EXPIRATION=86400000

# RabbitMQ STOMP Broker Credentials
RABBITMQ_USER=syncpad
RABBITMQ_PASSWORD=CHANGE_ME_TO_RABBITMQ_STRONG_PASSWORD

# Backup Encryption (AES-256-CBC)
BACKUP_PASSPHRASE=CHANGE_ME_TO_ENCRYPTION_PASSPHRASE

# Google OAuth2 Client ID (Optional)
GOOGLE_CLIENT_ID=

# Allowed Origins
ALLOWED_ORIGINS=https://localhost,https://yourdomain.com

# JPA / Hibernate Mode
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true
